{
  "manifest_version": 3,
  "name": "Wander",
  "short_name": "Wander",
  "version": "1.0",
  "description": "Rediscover your saved bookmarks on every new tab",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
